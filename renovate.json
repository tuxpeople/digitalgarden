{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>tuxpeople/shared//renovate/renovate.json5",
    "github>tuxpeople/shared//renovate/labels.json5",
    "github>tuxpeople/shared//renovate/semanticCommits.json5"
  ],
  "dependencyDashboardTitle": "Renovate Dashboard \ud83e\udd16",
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "markdown-it-mathjax3 5.x loads MathJax via deasync and hangs the Eleventy 3 build",
      "matchPackageNames": [
        "markdown-it-mathjax3"
      ],
      "allowedVersions": "<5"
    }
  ]
}
